# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env al repositorio.

# Supabase — https://app.supabase.com → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google Maps — https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_UPLOAD_PRESET=servilink_unsigned
